.focus-page { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%); padding: 48rpx; }
.timer-container { position: relative; width: 480rpx; height: 480rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 48rpx; }
.timer-circle { width: 400rpx; height: 400rpx; border-radius: 50%; background: rgba(108, 92, 231, 0.2); border: 6rpx solid rgba(108, 92, 231, 0.5); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2; }
.timer-circle.running { border-color: var(--primary); box-shadow: 0 0 40rpx rgba(108, 92, 231, 0.4); animation: pulse 2s ease-in-out infinite; }
.timer-time { font-size: 96rpx; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
.timer-label { font-size: var(--font-md); color: rgba(255,255,255,0.6); margin-top: 8rpx; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }
.focus-task { text-align: center; margin-bottom: 32rpx; }
.focus-task-label { font-size: var(--font-sm); color: rgba(255,255,255,0.5); }
.focus-task-title { font-size: var(--font-lg); color: #fff; font-weight: 600; }
.pomodoro-count { margin-bottom: 48rpx; font-size: 48rpx; }
.focus-controls { display: flex; gap: 24rpx; margin-bottom: 48rpx; }
.control-btn { padding: 24rpx 64rpx; border-radius: var(--radius-full); font-size: var(--font-lg); font-weight: 700; background: var(--primary); color: #fff; border: none; }
.control-btn::after { border: none; }
.control-btn.pause { background: var(--warning); color: #333; }
.control-btn.stop { background: var(--danger); }
.focus-settings { width: 100%; max-width: 600rpx; }
.setting-row { margin-bottom: 32rpx; }
.setting-label { font-size: var(--font-md); color: rgba(255,255,255,0.7); margin-bottom: 12rpx; }
.sound-options { display: flex; gap: 24rpx; margin-top: 12rpx; }
.sound-btn { font-size: 48rpx; padding: 12rpx; border-radius: var(--radius-md); opacity: 0.5; }
.sound-btn.active { opacity: 1; background: rgba(108,92,231,0.3); }
