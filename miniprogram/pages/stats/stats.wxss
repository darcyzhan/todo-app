.page-title { font-size: var(--font-xl); font-weight: 700; margin-bottom: 24rpx; }
.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.summary-card { display: flex; flex-direction: column; align-items: center; padding: 24rpx !important; }
.summary-value { font-size: var(--font-xxl); font-weight: 700; }
.summary-label { font-size: var(--font-xs); color: var(--text-secondary); margin-top: 8rpx; }
.chart-card { margin-bottom: 24rpx; }
.chart-title { font-size: var(--font-md); font-weight: 700; margin-bottom: 20rpx; }
.bar-chart { display: flex; justify-content: space-around; align-items: flex-end; height: 300rpx; padding: 0 16rpx; }
.bar-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.bar-wrap { display: flex; align-items: flex-end; height: 240rpx; }
.bar { width: 40rpx; background: var(--primary); border-radius: 8rpx 8rpx 0 0; min-height: 8rpx; transition: height 0.3s ease; }
.bar-label { font-size: var(--font-xs); color: var(--text-secondary); margin-top: 8rpx; }
.dist-list { display: flex; flex-direction: column; gap: 16rpx; }
.dist-item { display: flex; align-items: center; gap: 12rpx; }
.dist-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dist-label { flex: 1; font-size: var(--font-md); }
.dist-value { font-weight: 700; font-size: var(--font-lg); }
.completed-list { display: flex; flex-direction: column; gap: 12rpx; }
.completed-item { display: flex; align-items: center; gap: 12rpx; }
.completed-check { color: var(--success); font-weight: 700; }
.completed-title { font-size: var(--font-md); }
