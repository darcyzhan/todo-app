.page-title{font-size:var(--font-xl);font-weight:700;margin-bottom:24rpx}.setting-section{margin-bottom:24rpx}.section-title{font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:16rpx}.theme-options{display:flex;gap:16rpx}.theme-opt{flex:1;text-align:center;padding:16rpx;border-radius:var(--radius-md);background:var(--bg-light);font-size:var(--font-sm)}.theme-opt.active{background:var(--primary);color:#fff}.setting-item{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-bottom:1rpx solid var(--border)}.setting-item:last-child{border-bottom:none}
