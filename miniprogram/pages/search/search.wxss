.search-bar{padding:16rpx 0}.search-input{width:100%;padding:20rpx;background:var(--card-light);border-radius:var(--radius-full);box-shadow:var(--shadow-sm);box-sizing:border-box;font-size:var(--font-md)}.result-item{display:flex;justify-content:space-between;align-items:center;padding:20rpx!important}.result-title{flex:1;font-size:var(--font-md)}.result-status{font-size:var(--font-xs);padding:4rpx 12rpx;border-radius:var(--radius-full)}.status-todo{background:#f0f0f0;color:var(--text-secondary)}.status-done{background:#55efc440;color:var(--success)}.status-in_progress{background:#74b9ff40;color:var(--info)}.empty-hint{text-align:center;color:var(--text-hint);padding:48rpx}
