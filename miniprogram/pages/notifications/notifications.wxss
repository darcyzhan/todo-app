.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.title{font-size:var(--font-xl);font-weight:700}.read-all{color:var(--primary);font-size:var(--font-sm)}.notif-item{display:flex;flex-direction:column;gap:8rpx}.notif-item.unread{border-left:6rpx solid var(--primary)}.notif-title{font-weight:600}.notif-content{font-size:var(--font-sm)}.notif-time{font-size:var(--font-xs)}
