.page { background: var(--bg-light); }

.section { margin-bottom: 32rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.section-title { font-size: var(--font-lg); font-weight: 700; }
.toggle-arrow { font-size: var(--font-sm); color: var(--text-hint); transition: transform 0.2s; }
.toggle-arrow.open { transform: rotate(180deg); }

.nlp-section { background: var(--card-light); border-radius: var(--radius-lg); padding: 24rpx; box-shadow: var(--shadow-sm); }
.nlp-input-wrap { display: flex; gap: 16rpx; align-items: center; }
.nlp-input { flex: 1; padding: 16rpx; background: var(--bg-light); border-radius: var(--radius-md); font-size: var(--font-md); }
.nlp-hint { font-size: var(--font-xs); color: var(--text-hint); margin-top: 12rpx; }

.form-group { margin-bottom: 32rpx; }
.form-label { font-size: var(--font-md); font-weight: 600; margin-bottom: 12rpx; display: block; }
.form-input { width: 100%; padding: 20rpx; background: var(--card-light); border-radius: var(--radius-md); font-size: var(--font-md); box-shadow: var(--shadow-sm); box-sizing: border-box; }
.form-textarea { width: 100%; padding: 20rpx; background: var(--card-light); border-radius: var(--radius-md); font-size: var(--font-md); min-height: 160rpx; box-shadow: var(--shadow-sm); box-sizing: border-box; }

.priority-selector { display: flex; gap: 16rpx; }
.priority-option { padding: 12rpx 32rpx; border-radius: var(--radius-full); font-size: var(--font-sm); font-weight: 600; background: var(--card-light); color: var(--text-secondary); box-shadow: var(--shadow-sm); }
.priority-option.selected { background: var(--p-color); color: #fff; }

.project-selector { display: flex; flex-wrap: wrap; gap: 12rpx; }
.project-option { padding: 10rpx 24rpx; border-radius: var(--radius-full); font-size: var(--font-sm); background: var(--card-light); box-shadow: var(--shadow-sm); }
.project-option.selected { background: var(--primary); color: #fff; }

.date-row { display: flex; gap: 16rpx; }
.date-picker-btn { padding: 16rpx 24rpx; background: var(--card-light); border-radius: var(--radius-md); font-size: var(--font-md); box-shadow: var(--shadow-sm); }

.energy-selector { display: flex; gap: 16rpx; }
.energy-option { padding: 12rpx 24rpx; border-radius: var(--radius-full); font-size: var(--font-sm); background: var(--card-light); box-shadow: var(--shadow-sm); }
.energy-option.selected { background: var(--primary); color: #fff; }

.tag-selector { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-option { padding: 8rpx 20rpx; border-radius: var(--radius-full); font-size: var(--font-sm); background: var(--card-light); box-shadow: var(--shadow-sm); }
.tag-option.selected { background: var(--tag-color); color: #fff; }

.subtask-list { display: flex; flex-direction: column; gap: 12rpx; }
.subtask-row { display: flex; align-items: center; gap: 12rpx; }
.subtask-bullet { color: var(--primary); font-size: var(--font-lg); }
.subtask-input { flex: 1; padding: 12rpx; background: var(--card-light); border-radius: var(--radius-md); font-size: var(--font-md); }
.subtask-remove { color: var(--danger); font-size: var(--font-lg); padding: 8rpx; }
.add-subtask { color: var(--primary); font-size: var(--font-md); margin-top: 12rpx; }

.recurring-header { display: flex; justify-content: space-between; align-items: center; }
.switch { width: 80rpx; height: 44rpx; border-radius: 22rpx; background: var(--border); position: relative; transition: background 0.2s; }
.switch.on { background: var(--primary); }
.switch-dot { width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; position: absolute; top: 4rpx; left: 4rpx; transition: left 0.2s; }
.switch.on .switch-dot { left: 40rpx; }

.recurrence-options { display: flex; gap: 12rpx; margin-top: 16rpx; }
.recurrence-option { padding: 10rpx 24rpx; border-radius: var(--radius-full); font-size: var(--font-sm); background: var(--card-light); }
.recurrence-option.selected { background: var(--primary); color: #fff; }

.submit-btn { margin-top: 48rpx; width: 100%; }
