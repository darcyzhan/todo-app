.calendar-header { display: flex; align-items: center; justify-content: center; gap: 24rpx; padding: 24rpx 0; }
.month-title { font-size: var(--font-xl); font-weight: 700; }
.nav-btn { font-size: var(--font-lg); padding: 12rpx 20rpx; color: var(--primary); }
.today-btn { font-size: var(--font-sm); color: var(--primary); margin-left: 16rpx; }
.week-headers { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 8rpx; }
.week-header { font-size: var(--font-sm); color: var(--text-hint); padding: 8rpx; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4rpx; }
.day-cell { display: flex; flex-direction: column; align-items: center; padding: 12rpx 4rpx; border-radius: var(--radius-md); position: relative; }
.day-cell.prev, .day-cell.next { opacity: 0.3; }
.day-cell.today .day-number { color: var(--primary); font-weight: 700; }
.day-cell.selected { background: var(--primary); }
.day-cell.selected .day-number { color: #fff; }
.day-number { font-size: var(--font-sm); }
.day-dots { display: flex; gap: 4rpx; margin-top: 4rpx; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; }
.date-tasks { margin-top: 32rpx; }
.date-title { font-size: var(--font-md); font-weight: 600; margin-bottom: 16rpx; }
.task-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx !important; }
.task-left { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.priority-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.task-name { font-size: var(--font-md); }
.task-name.done { text-decoration: line-through; opacity: 0.5; }
.task-status { color: var(--success); }
.empty-hint { text-align: center; color: var(--text-hint); padding: 48rpx; }
