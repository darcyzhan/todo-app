.page-title{font-size:var(--font-xl);font-weight:700;margin-bottom:24rpx}.project-card{display:flex;align-items:center;gap:16rpx}.project-icon{font-size:48rpx}.project-info{flex:1}.project-name{font-weight:600}.project-desc{font-size:var(--font-sm)}.delete-btn{font-size:var(--font-lg);padding:8rpx}.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:999}.modal-content{width:80vw;padding:48rpx!important}.modal-title{font-size:var(--font-lg);font-weight:700;text-align:center;margin-bottom:24rpx}.form-input{width:100%;padding:20rpx;background:var(--bg-light);border-radius:var(--radius-md);margin-bottom:16rpx;box-sizing:border-box}.form-label{font-size:var(--font-sm);color:var(--text-secondary);margin:12rpx 0 8rpx}.icon-grid{display:flex;flex-wrap:wrap;gap:12rpx}.icon-opt{font-size:40rpx;padding:8rpx;border-radius:var(--radius-md);border:2rpx solid transparent}.icon-opt.sel{border-color:var(--primary);background:rgba(108,92,231,.1)}.color-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:24rpx}.color-opt{width:56rpx;height:56rpx;border-radius:50%;border:4rpx solid transparent}.color-opt.sel{border-color:#333;transform:scale(1.1)}
