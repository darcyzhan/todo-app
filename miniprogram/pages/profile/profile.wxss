.profile-header { display: flex; align-items: center; padding: 48rpx 32rpx; background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%); }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; }
.avatar-text { font-size: 56rpx; color: #fff; font-weight: 700; }
.user-info { flex: 1; margin-left: 24rpx; }
.nickname { font-size: var(--font-xl); font-weight: 700; color: #fff; display: block; }
.membership { font-size: var(--font-sm); color: rgba(255,255,255,0.8); }
.logout-btn { color: rgba(255,255,255,0.8); font-size: var(--font-sm); padding: 8rpx 24rpx; border: 2rpx solid rgba(255,255,255,0.5); border-radius: var(--radius-full); }
.login-prompt { display: flex; flex-direction: column; align-items: center; padding: 120rpx 48rpx; }
.prompt-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.prompt-text { font-size: var(--font-lg); color: var(--text-secondary); margin-bottom: 32rpx; }
.quick-stats { display: flex; justify-content: space-around; margin: 24rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: var(--font-xl); font-weight: 700; }
.stat-label { font-size: var(--font-xs); color: var(--text-secondary); }
.menu-list { margin: 24rpx; padding: 0 !important; }
.menu-item { display: flex; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--border); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: var(--font-lg); margin-right: 20rpx; }
.menu-title { flex: 1; font-size: var(--font-md); }
.menu-badge { background: var(--danger); color: #fff; font-size: var(--font-xs); padding: 2rpx 12rpx; border-radius: var(--radius-full); min-width: 32rpx; text-align: center; }
.menu-arrow { font-size: var(--font-xl); color: var(--text-hint); }
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal-content { width: 80vw; padding: 48rpx !important; }
.modal-title { font-size: var(--font-xl); font-weight: 700; text-align: center; margin-bottom: 32rpx; }
.form-input { width: 100%; padding: 20rpx; background: var(--bg-light); border-radius: var(--radius-md); font-size: var(--font-md); margin-bottom: 20rpx; box-sizing: border-box; }
.btn-primary { width: 100%; margin-top: 16rpx; }
.switch-text { text-align: center; color: var(--primary); font-size: var(--font-sm); margin-top: 20rpx; }
