<view class="page container">
  <text class="page-title">🔥 习惯追踪</text>

  <view class="habit-list">
    <view class="habit-card card" wx:for="{{habits}}" wx:key="id">
      <view class="habit-header">
        <text class="habit-icon">{{item.icon}}</text>
        <text class="habit-title">{{item.title}}</text>
        <text class="streak" wx:if="{{item.streak}}">🔥 {{item.streak}}天</text>
      </view>
      <view class="habit-actions">
        <button
          class="log-btn {{item.today_logged ? 'logged' : ''}}"
          catchtap="onLog"
          data-id="{{item.id}}"
        >
          {{item.today_logged ? '✓ 已打卡' : '打卡'}}
        </button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!habits.length}}">
    <text class="empty-state-icon">🎯</text>
    <text class="empty-state-text">还没有习惯，来创建一个吧</text>
  </view>

  <!-- Create Modal -->
  <view class="modal-overlay" wx:if="{{showCreateModal}}" bindtap="onHideCreate">
    <view class="modal-content card" catchtap>
      <text class="modal-title">新建习惯</text>
      <input class="form-input" placeholder="习惯名称" value="{{newHabit.title}}" bindinput="onNewTitleInput" />
      <text class="form-label">选择图标</text>
      <view class="icon-grid">
        <text wx:for="{{icons}}" wx:key="*this" class="icon-option {{newHabit.icon === item ? 'selected' : ''}}" bindtap="onIconSelect" data-icon="{{item}}">{{item}}</text>
      </view>
      <text class="form-label">选择颜色</text>
      <view class="color-grid">
        <view wx:for="{{colors}}" wx:key="*this" class="color-option {{newHabit.color === item ? 'selected' : ''}}" style="background: {{item}}" bindtap="onColorSelect" data-color="{{item}}"></view>
      </view>
      <button class="btn-primary" bindtap="onCreateHabit">创建习惯</button>
    </view>
  </view>

  <view class="fab" bindtap="onShowCreate">+</view>
</view>
