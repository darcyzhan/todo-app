.page {
  min-height: 100vh;
  background: var(--bg-light);
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

/* Stats Bar */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 28rpx 24rpx;
  margin: 24rpx 24rpx 0;
  border-radius: var(--radius-lg);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

/* Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--card-light);
  border-radius: var(--radius-full);
  padding: 12rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: var(--font-md);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-md);
}

.view-toggle {
  display: flex;
  gap: 8rpx;
}

.toggle-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: 36rpx;
  background: var(--card-light);
  box-shadow: var(--shadow-sm);
}

.toggle-btn.active {
  background: var(--primary);
  color: #fff;
}

/* Filter Chips */
.filter-chips {
  padding: 0 24rpx 16rpx;
  white-space: nowrap;
}

.chip-row {
  display: flex;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  background: var(--card-light);
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.chip-active {
  background: var(--primary);
  color: #fff;
}

.chip-outline {
  border: 1rpx solid var(--primary);
  color: var(--primary);
  background: transparent;
}

/* Filter Panel */
.filter-panel {
  padding: 24rpx;
  background: var(--card-light);
  margin: 0 24rpx 16rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  animation: slideUp 0.2s ease-out;
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-title {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* Task List */
.task-list {
  padding: 0 24rpx;
}

.task-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx !important;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.task-card:active {
  transform: scale(0.98);
}

.task-done {
  opacity: 0.6;
}

.task-done .task-title {
  text-decoration: line-through;
}

.task-selected {
  border: 2rpx solid var(--primary);
  background: rgba(108, 92, 231, 0.05);
}

/* Checkbox */
.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.task-checkbox.checked {
  background: var(--success);
  border-color: var(--success);
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* Task Content */
.task-content {
  flex: 1;
  min-width: 0;
}

.task-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-title {
  font-size: var(--font-md);
  font-weight: 600;
  flex: 1;
}

.priority-badge {
  font-size: var(--font-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
  flex-shrink: 0;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: var(--font-sm);
}

.task-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag-chip {
  font-size: var(--font-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.task-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 12rpx;
  margin-left: 12rpx;
}

.status-todo { background: var(--text-hint); }
.status-in_progress { background: var(--info); }
.status-done { background: var(--success); }

/* Multi-select bar */
.multi-select-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-light);
  padding: 16rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 200;
}

.multi-select-info {
  font-weight: 600;
}

.multi-select-actions {
  display: flex;
  gap: 12rpx;
}

.btn-sm {
  font-size: var(--font-sm);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

.btn-success {
  background: var(--success);
  color: #fff;
}

/* Loading */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  color: var(--text-hint);
  font-size: var(--font-sm);
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
